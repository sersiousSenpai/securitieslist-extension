{
  "manifest_version": 3,
  "name": "Securities List",
  "short_name": "SecuritiesList",
  "version": "0.1.0",
  "description": "Legal and regulatory risk signals for the stock you're reading about: investigations, class actions, SEC red flags, short reports.",
  "minimum_chrome_version": "127",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Securities List",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://robinhood.com/*",
    "https://finance.yahoo.com/*",
    "https://www.google.com/finance/*",
    "https://seekingalpha.com/*",
    "https://www.marketwatch.com/*",
    "https://www.cnbc.com/*",
    "https://www.nasdaq.com/*",
    "https://stocktwits.com/*",
    "https://*.globenewswire.com/*",
    "https://*.prnewswire.com/*",
    "https://*.businesswire.com/*",
    "https://*.accesswire.com/*",
    "https://*.bloomberg.com/*",
    "https://*.reuters.com/*",
    "https://*.wsj.com/*",
    "https://*.barrons.com/*",
    "https://*.morningstar.com/*",
    "https://*.tradingview.com/*",
    "https://*.fool.com/*",
    "https://*.zacks.com/*",
    "https://*.benzinga.com/*",
    "https://*.barchart.com/*",
    "https://*.marketbeat.com/*",
    "https://*.stockanalysis.com/*",
    "https://*.tipranks.com/*",
    "https://*.simplywall.st/*",
    "https://*.wallstreetzen.com/*",
    "https://*.finviz.com/*",
    "https://markets.ft.com/*",
    "https://*.webull.com/*",
    "https://*.public.com/*",
    "https://*.moomoo.com/*",
    "https://digital.fidelity.com/*",
    "https://*.etrade.com/*",
    "https://client.schwab.com/*",
    "https://*.newsfilecorp.com/*",
    "https://*.einpresswire.com/*",
    "https://*.investing.com/*",
    "https://securities.stanford.edu/*",
    "https://*.muddywatersresearch.com/*",
    "https://*.sprucepointcap.com/*",
    "https://*.culperresearch.com/*",
    "https://*.grizzlyreports.com/*",
    "https://*.kerrisdalecap.com/*",
    "https://*.fuzzypandaresearch.com/*",
    "https://*.wolfpackresearch.com/*",
    "https://*.blueorcacapital.com/*",
    "https://*.iceberg-research.com/*",
    "https://*.supabase.co/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://*.globenewswire.com/*",
        "https://*.prnewswire.com/*",
        "https://*.businesswire.com/*",
        "https://*.accesswire.com/*",
        "https://*.newsfilecorp.com/*",
        "https://*.einpresswire.com/*",
        "https://*.investing.com/*",
        "https://securities.stanford.edu/*",
        "https://*.muddywatersresearch.com/*",
        "https://*.sprucepointcap.com/*",
        "https://*.culperresearch.com/*",
        "https://*.grizzlyreports.com/*",
        "https://*.kerrisdalecap.com/*",
        "https://*.fuzzypandaresearch.com/*",
        "https://*.wolfpackresearch.com/*",
        "https://*.blueorcacapital.com/*",
        "https://*.iceberg-research.com/*",
        "http://localhost:8000/demo/wire/*"
      ],
      "js": ["src/scanner.js", "content/wire.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://robinhood.com/*"],
      "js": ["content/portfolio.js"],
      "run_at": "document_idle"
    }
  ]
}
